# Server production: isi nilai lokal, jangan commit .env.
OJOL_ENV=production
OJOL_OPERATOR_AUTHORIZED=false
OJOL_MANAGED_BROWSER=true
# http = core ringan; browser = Browser Harness lama. Fallback otomatis hanya untuk pembacaan.
OJOL_CORE=http
OJOL_BROWSER_FALLBACK=true
OJOL_CDP_URL=http://127.0.0.1:9222
OJOL_RUNTIME_DIR=.local
OJOL_LOGIN_PUBLIC_URL=https://ojolkampung.sftch.web.id
OJOL_TUNNEL_ENABLED=true
OJOL_TELEGRAM_BOT_TOKEN=
OJOL_TELEGRAM_CHAT_ID=
OJOL_MIN_BALANCE=20
OJOL_THRESHOLD=60
OJOL_RESOURCE_RESERVE_PERCENT=20
# Kosong = tanpa batas belanja, jumlah trip, dan durasi.
OJOL_MAX_SPEND=
OJOL_MAX_JOBS=
OJOL_MAX_MINUTES=
OJOL_IDLE_POLL_SECONDS=10
