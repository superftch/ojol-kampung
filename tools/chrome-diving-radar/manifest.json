{
  "manifest_version": 3,
  "name": "KampungSebelah - Diving, Mancing, Ojol, TPU, Berburu & Sepak Bola",
  "version": "2.6.0",
  "description": "Radar & Auto-Pilot Diving Laut, Otomatisasi Mancing Pro, Auto-Ojol, TPU Pusaka Mbah Rukmi, Berburu Sniper, serta Radar & Auto-Play Sepak Bola / Futsal untuk Kampung Sebelah.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.kampungsebelah.com/*",
    "https://kampungsebelah.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "KampungSebelah Helper"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.kampungsebelah.com/*",
        "https://kampungsebelah.com/*"
      ],
      "js": [
        "diving-human.js",
        "diving-route.js",
        "content.js",
        "mancing.js",
        "ojol.js",
        "kebutuhan.js",
        "tpu.js",
        "berburu.js",
        "futsal.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js",
        "diving-avoid.js",
        "diving-human.js",
        "diving-open.js",
        "diving-shark.js",
        "berburu-inject.js",
        "futsal-inject.js"
      ],
      "matches": [
        "https://www.kampungsebelah.com/*",
        "https://kampungsebelah.com/*"
      ]
    }
  ]
}
